# Sentry configuration for Moneat E2E KMP App
# Copy this to local.properties and update with your actual DSN

# Get the DSN from Moneat dashboard after creating a project
# Format: http://PUBLIC_KEY@localhost:8080/PROJECT_ID
sentry.dsn=

# Or use the full URL if Moneat is running elsewhere
# sentry.dsn=http://PUBLIC_KEY@your-moneat-host:8080/PROJECT_ID
