# ============================================================================
# MONEAT BACKEND ENVIRONMENT CONFIGURATION
# ============================================================================
# This is an example configuration for LOCAL DEVELOPMENT.
# For production deployment, see ESSENTIAL_ENV_VARS.md for required variables.
#
# CRITICAL: Never commit actual secrets to this file!
# ============================================================================

# Server Configuration
PORT=8080

# CRITICAL: Production URLs - Change these for local development only
# Production default: https://api.moneat.io
BACKEND_URL=http://localhost:8080

# Production default: https://moneat.io  
FRONTEND_URL=http://localhost:5173

# Database - PostgreSQL
DATABASE_URL=jdbc:postgresql://localhost:5499/moneat
DATABASE_USER=moneat
# CRITICAL: Change in production! This is only for local development.
DATABASE_PASSWORD=moneat_dev_password

# Database - ClickHouse
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=moneat
# CRITICAL: Change in production! This is only for local development.
CLICKHOUSE_PASSWORD=moneat_dev_password

# Redis
REDIS_URL=redis://localhost:6379

# JWT Configuration
# CRITICAL: MUST be changed in production! Generate with: openssl rand -base64 64
JWT_SECRET=change-this-secret-in-production

# Email Configuration
EMAIL_FROM=noreply@moneat.app

# SMTP Configuration (for email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true

# Sentry Configuration (for backend self-monitoring)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# GitHub API cache TTL for SDK version resolution in setup docs
GITHUB_VERSIONS_CACHE_TTL_SECONDS=21600

# Stripe / Billing
STRIPE_ENABLED=false
BILLING_ENFORCEMENT_ENABLED=false
BILLING_BACKGROUND_JOBS_ENABLED=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_METER_EVENT_NAME=moneat_overage_units

# Legal document versions
LEGAL_TERMS_VERSION=2026-02-08
LEGAL_PRIVACY_VERSION=2026-02-08
VITE_LEGAL_TERMS_VERSION=2026-02-08
VITE_LEGAL_PRIVACY_VERSION=2026-02-08

# Slack Integration (OAuth App)
# Set SLACK_ENABLED=false for local development if you don't have Slack credentials
SLACK_ENABLED=false
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Production default: https://api.moneat.io/v1/integrations/slack/oauth/callback
SLACK_REDIRECT_URI=http://localhost:8080/v1/integrations/slack/oauth/callback

# Discord Integration (OAuth App)
# Set DISCORD_ENABLED=false for local development if you don't have Discord credentials
DISCORD_ENABLED=false
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Production default: https://api.moneat.io/v1/integrations/discord/oauth/callback
DISCORD_REDIRECT_URI=http://localhost:8080/v1/integrations/discord/oauth/callback
DISCORD_BOT_TOKEN=

# Moneat Self-Logging (optional - for dogfooding)
# Leave DSN empty to disable
MONEAT_LOGS_ENDPOINT=http://localhost:8080/v1/logs/otlp
MONEAT_LOGS_DSN=
MONEAT_LOGS_SERVICE_NAME=moneat-backend
MONEAT_LOGS_ENVIRONMENT=development

# On-Call and Push Notifications
# CRITICAL: Required for mobile push notifications
ONCALL_ENABLED=false
EXPO_TOKEN=

# OAuth Providers (optional - for social login)
# GitHub OAuth App
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Apple Sign In
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# APPLE_PRIVATE_KEY should be the base64-encoded .p8 private key file
APPLE_PRIVATE_KEY=

