# ============================================================================
# MONEAT BACKEND ENVIRONMENT CONFIGURATION
# ============================================================================
# This is an example configuration for LOCAL DEVELOPMENT.
# For production deployment, see ESSENTIAL_ENV_VARS.md for required variables.
#
# CRITICAL: Never commit actual secrets to this file!
# ============================================================================

# ----------------------------------------------------------------------------
# Server
# ----------------------------------------------------------------------------
PORT=8080

# Public URL of this backend API. Production default: https://api.moneat.io
BACKEND_URL=http://localhost:8080

# Public URL of the frontend dashboard. Production default: https://moneat.io
FRONTEND_URL=http://localhost:3000

# Comma-separated extra origins to allow in CORS (beyond FRONTEND_URL)
ALLOWED_ORIGINS=

# Trusted upstream proxy IPs/CIDRs consulted before accepting CF-Connecting-IP
# or X-Forwarded-For headers for rate-limiting. Only connections whose direct
# peer address matches an entry here will have those headers trusted; all other
# connections are rate-limited by their own IP.
# Example (Cloudflare + private LB): TRUSTED_PROXIES=103.21.244.0/22,10.0.0.0/8
TRUSTED_PROXIES=

# ----------------------------------------------------------------------------
# Database - PostgreSQL
# ----------------------------------------------------------------------------
DATABASE_URL=jdbc:postgresql://localhost:5499/moneat
DATABASE_USER=moneat
# CRITICAL: Change in production!
DATABASE_PASSWORD=moneat_dev_password

# ----------------------------------------------------------------------------
# Database - ClickHouse
# ----------------------------------------------------------------------------
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=moneat
# CRITICAL: Change in production!
CLICKHOUSE_PASSWORD=moneat_dev_password

# ----------------------------------------------------------------------------
# Redis
# ----------------------------------------------------------------------------
# CRITICAL: Change in production!
REDIS_PASSWORD=moneat_dev_password
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379

# Hard queue admission and per-pipeline ingestion-worker processing bounds.
INGESTION_QUEUE_MAX_PENDING_ENTRIES=250000
INGESTION_MAX_CONCURRENT_BATCHES=2
# Optional per-pipeline overrides:
# INGESTION_DD_METRICS_WORKER_COUNT=2
# INGESTION_DD_METRICS_MAX_PENDING_ENTRIES=250000
# INGESTION_DD_METRICS_MAX_CONCURRENT_BATCHES=2

# ----------------------------------------------------------------------------
# Datadog metric ingestion
# ----------------------------------------------------------------------------
# Max rows and queued payloads to combine into one ClickHouse insert.
DD_METRIC_BATCH_MAX_ROWS=20000
DD_METRIC_BATCH_MAX_PAYLOADS=100

# ----------------------------------------------------------------------------
# Workflow Runtime (Temporal)
# ----------------------------------------------------------------------------
TEMPORAL_TARGET=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_GRPC_PORT=7233
TEMPORAL_UI_PORT=8233
TEMPORAL_DB_USER=temporal
# CRITICAL: Change in production!
TEMPORAL_DB_PASSWORD=temporal_dev_password
# CRITICAL: Must be distinct from JWT_SECRET and DATA_SOURCE_ENCRYPTION_KEY.
# Generate each with: openssl rand -base64 32
WORKFLOWS_CONNECTION_KEK=change-this-workflow-connection-key-in-production
WORKFLOWS_SIGNING_KEY=change-this-workflow-signing-key-in-production
WORKFLOWS_TEMPORAL_PAYLOAD_KEY=change-this-workflow-payload-key-in-production

# Worker mode for this process: TRUSTED (default), EGRESS, ALL (single node), or NONE.
WORKFLOWS_WORKER_MODE=trusted
# Enables the http.request and transform.graaljs actions. Default false.
WORKFLOWS_EGRESS_ENABLED=false
# Forward proxy used for outbound requests when running the egress worker.
# WORKFLOWS_EGRESS_PROXY_URL=http://egress-proxy:3128

# ----------------------------------------------------------------------------
# JWT
# ----------------------------------------------------------------------------
# CRITICAL: MUST be changed in production! Generate with: openssl rand -base64 64
JWT_SECRET=change-this-secret-in-production

# ----------------------------------------------------------------------------
# Custom Data Source Credential Encryption
# ----------------------------------------------------------------------------
# CRITICAL: Required for custom data source credentials. Must be separate from JWT_SECRET.
# Generate with: openssl rand -base64 32
DATA_SOURCE_ENCRYPTION_KEY=change-this-encryption-key-in-production

# ----------------------------------------------------------------------------
# Email / SMTP
# ----------------------------------------------------------------------------
EMAIL_FROM=noreply@moneat.app
# Inbox that receives Enterprise sales-contact form submissions (defaults to support@moneat.io)
SALES_INBOX=support@moneat.io
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
# Set to true when self-hosting (enables DISABLE_EMAIL_VERIFICATION and first-user auto-admin)
SELF_HOSTED=false
# Set to true to skip email verification for all new signups (requires SELF_HOSTED=true)
DISABLE_EMAIL_VERIFICATION=false

# ----------------------------------------------------------------------------
# Sentry (backend self-monitoring)
# ----------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
VITE_SENTRY_RELEASE=
VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=1.0
VITE_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1.0
VITE_DD_VERSION=
VITE_MONEAT_VERSION=

# ----------------------------------------------------------------------------
# Moneat Self-Logging / dogfooding (leave DSN empty to disable)
# ----------------------------------------------------------------------------
MONEAT_LOGS_ENDPOINT=http://localhost:8080/v1/logs/otlp
MONEAT_LOGS_DSN=
MONEAT_LOGS_SERVICE_NAME=moneat-backend
MONEAT_LOGS_ENVIRONMENT=development
METRICS_SCRAPE_TOKEN=

# ----------------------------------------------------------------------------
# Stripe / Billing
# ----------------------------------------------------------------------------
STRIPE_ENABLED=false
BILLING_BACKGROUND_JOBS_ENABLED=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_METER_EVENT_NAME=moneat_overage_units
STRIPE_CUSTOM_METRIC_METER_EVENT_NAME=moneat_custom_metric_overage_units
STRIPE_APM_SPAN_METER_EVENT_NAME=moneat_apm_span_overage_units

# ----------------------------------------------------------------------------
# Legal document versions
# ----------------------------------------------------------------------------
LEGAL_TERMS_VERSION=2026-02-08
LEGAL_PRIVACY_VERSION=2026-02-08

# ----------------------------------------------------------------------------
# Enterprise License
# RSA-signed license key to activate enterprise modules (SAML SSO, On-Call).
# Without this, only the open-source core is active.
# Enterprise modules are subject to the Moneat Enterprise License (see ee/LICENSE).
# Contact licensing@moneat.io or visit https://moneat.io/pricing to obtain a key.
# ----------------------------------------------------------------------------
MONEAT_LICENSE_KEY=

# ----------------------------------------------------------------------------
# Feature Flags
# Selects which feature-flag environment this deployment evaluates flags against.
# Optional; defaults to "production". Set this to the environment used by your
# other feature-flag rules, for example "staging".
# ----------------------------------------------------------------------------
MONEAT_FEATURE_FLAG_ENVIRONMENT=production

# ----------------------------------------------------------------------------
# SSO (OIDC)
# OpenID Connect single sign-on. Works with any OIDC provider (Authentik,
# Authelia, Keycloak, Okta, Azure AD, etc.). No license key required.
# Configure via the dashboard under Settings > SSO.
# ----------------------------------------------------------------------------

# ----------------------------------------------------------------------------
# Slack Integration
# ----------------------------------------------------------------------------
SLACK_ENABLED=false
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# Production default: https://api.moneat.io/v1/integrations/slack/oauth/callback
SLACK_REDIRECT_URI=http://localhost:8080/v1/integrations/slack/oauth/callback

# ----------------------------------------------------------------------------
# Discord Integration
# ----------------------------------------------------------------------------
DISCORD_ENABLED=false
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
# Production default: https://api.moneat.io/v1/integrations/discord/oauth/callback
DISCORD_REDIRECT_URI=http://localhost:8080/v1/integrations/discord/oauth/callback

# ----------------------------------------------------------------------------
# On-Call / Push Notifications
# CRITICAL: EXPO_TOKEN is required when ONCALL_ENABLED=true
# ----------------------------------------------------------------------------
ONCALL_ENABLED=false
EXPO_TOKEN=

# ----------------------------------------------------------------------------
# OAuth Providers (social login)
# ----------------------------------------------------------------------------
# GitHub
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Apple Sign In (APPLE_PRIVATE_KEY = base64-encoded .p8 file)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ----------------------------------------------------------------------------
# AI Chat Assistant (provider-neutral runtime)
# Automatically enabled for admin users once a provider is configured: either an
# API key resolves, or AI_AUTH_TYPE=none points at a keyless local endpoint.
# Keep real keys out of committed files; leave the *_API_KEY values blank here.
# ----------------------------------------------------------------------------
# Provider dialect: openai, openai-compatible, or anthropic.
# Use openai-compatible for any vendor-agnostic or self-hosted endpoint that
# speaks the OpenAI Chat Completions API (vLLM, Ollama, LM Studio, and hosted
# OpenAI-compatible gateways).
AI_PROVIDER=openai

# API base URL. Defaults to https://api.openai.com for openai/openai-compatible
# and https://api.anthropic.com for anthropic. Point openai-compatible at your
# own endpoint, e.g. http://localhost:11434 or https://gateway.internal/v1; the
# runtime appends /v1 itself and won't double it when the URL already ends in /v1.
# Required when AI_AUTH_TYPE=none: keyless mode has no default and never falls
# back to a public provider endpoint, so AI_BASE_URL must be set explicitly.
# AI_BASE_URL=

# Model identifier sent to the provider. Defaults to gpt-4o-mini for
# openai/openai-compatible and claude-sonnet-4-20250514 for anthropic.
# AI_MODEL=gpt-4o-mini

# Provider-neutral API key. When unset the runtime falls back to
# OPENAI_API_KEY (openai/openai-compatible) or ANTHROPIC_API_KEY (anthropic).
AI_API_KEY=

# Authentication scheme:
#   default - Bearer for the openai dialects, x-api-key for anthropic (default).
#   bearer  - always send "Authorization: Bearer <key>".
#   header  - send a custom header (see AI_AUTH_HEADER / AI_AUTH_PREFIX).
#   none    - send no auth header (for unauthenticated local gateways).
# AI_AUTH_TYPE=default

# Custom auth header, used only when AI_AUTH_TYPE=header. The header value is
# "<AI_AUTH_PREFIX> <key>", or just <key> when no prefix is set. For example
# AI_AUTH_HEADER=api-key with no prefix, or AI_AUTH_HEADER=Authorization with
# AI_AUTH_PREFIX=Bearer.
# AI_AUTH_HEADER=Authorization
# AI_AUTH_PREFIX=Bearer

# Per-request timeout in milliseconds (default 120000, must be positive).
# AI_REQUEST_TIMEOUT_MS=120000

# Retries after a failed request, 0-5 (default 2).
# AI_MAX_RETRIES=2

# Comma-separated capabilities the endpoint supports: json_mode, streaming,
# tool_calling. Defaults to all three for the openai dialects and
# streaming,tool_calling for anthropic. Narrow this when a compatible endpoint
# does not implement every capability.
# AI_CAPABILITIES=json_mode,streaming,tool_calling

# Legacy fallbacks, still honored when the matching AI_* values above are unset.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2048
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ----------------------------------------------------------------------------
# Miscellaneous
# ----------------------------------------------------------------------------
# Cache TTL for SDK version lookups in setup docs (seconds)
GITHUB_VERSIONS_CACHE_TTL_SECONDS=21600

# Self-host telemetry (only active when SELF_HOSTED=true)
# Anonymous usage metrics help us improve Moneat for self-hosters.
# Set to false to opt out. See https://moneat.io/docs/self-hosting/telemetry
TELEMETRY_ENABLED=true
# TELEMETRY_ENDPOINT=https://telemetry.moneat.io/v1/pulse

# Demo Mode (for public demo deployments)
DEMO_ENABLED=false
# Timestamp (ms) anchoring demo data — defaults to current time if unset
DEMO_EPOCH_MS=

# Continuous profile storage
# Should point to a persistent mounted volume in production.
PROFILE_STORAGE_PATH=/var/lib/moneat/profiles
# Max accepted profile payload size in bytes (default: 10 MiB).
PROFILE_MAX_PAYLOAD_BYTES=10485760

# ----------------------------------------------------------------------------
# Datadog Agent Integration
# ----------------------------------------------------------------------------
# Enable with: docker compose --profile datadog up -d
# The entrypoint script attaches the DD Java agent when DD_AGENT_HOST is set.
# DD_AGENT_HOST=datadog-agent
# DD_SERVICE=moneat-backend
# DD_ENV=production
# DD_VERSION=
# DD_PROFILING_ENABLED=true
# DD_PROFILING_HEAP_ENABLED=true
# DD_APM_CONFIG_PROFILING_DD_URL=https://api.moneat.io/api/v2/profile?api_key=<YOUR_MONEAT_AGENT_KEY>
# DD_TRACE_ENABLED=true
# DD_TRACE_SAMPLE_RATE=1.0
# DD_LOGS_INJECTION=true
# DD_DYNAMIC_INSTRUMENTATION_ENABLED=true
# DD_JMXFETCH_ENABLED=true
# DD_RUNTIME_METRICS_ENABLED=true
