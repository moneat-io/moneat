# ============================================================================
# MONEAT BACKEND ENVIRONMENT CONFIGURATION
# ============================================================================
# This is an example configuration for LOCAL DEVELOPMENT.
# For production deployment, see ESSENTIAL_ENV_VARS.md for required variables.
#
# CRITICAL: Never commit actual secrets to this file!
# ============================================================================

# ----------------------------------------------------------------------------
# Server
# ----------------------------------------------------------------------------
PORT=8080

# Public URL of this backend API. Production default: https://api.moneat.io
BACKEND_URL=http://localhost:8080

# Public URL of the frontend dashboard. Production default: https://moneat.io
FRONTEND_URL=http://localhost:5173

# Comma-separated extra origins to allow in CORS (beyond FRONTEND_URL)
ALLOWED_ORIGINS=

# ----------------------------------------------------------------------------
# Database - PostgreSQL
# ----------------------------------------------------------------------------
DATABASE_URL=jdbc:postgresql://localhost:5499/moneat
DATABASE_USER=moneat
# CRITICAL: Change in production!
DATABASE_PASSWORD=moneat_dev_password

# ----------------------------------------------------------------------------
# Database - ClickHouse
# ----------------------------------------------------------------------------
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=moneat
# CRITICAL: Change in production!
CLICKHOUSE_PASSWORD=moneat_dev_password

# ----------------------------------------------------------------------------
# Redis
# ----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ----------------------------------------------------------------------------
# JWT
# ----------------------------------------------------------------------------
# CRITICAL: MUST be changed in production! Generate with: openssl rand -base64 64
JWT_SECRET=change-this-secret-in-production

# ----------------------------------------------------------------------------
# Email / SMTP
# ----------------------------------------------------------------------------
EMAIL_FROM=noreply@moneat.app
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
# Set to true when self-hosting (enables DISABLE_EMAIL_VERIFICATION and first-user auto-admin)
SELF_HOSTED=false
# Set to true to skip email verification for all new signups (requires SELF_HOSTED=true)
DISABLE_EMAIL_VERIFICATION=false

# ----------------------------------------------------------------------------
# Sentry (backend self-monitoring)
# ----------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# ----------------------------------------------------------------------------
# Moneat Self-Logging / dogfooding (leave DSN empty to disable)
# ----------------------------------------------------------------------------
MONEAT_LOGS_ENDPOINT=http://localhost:8080/v1/logs/otlp
MONEAT_LOGS_DSN=
MONEAT_LOGS_SERVICE_NAME=moneat-backend
MONEAT_LOGS_ENVIRONMENT=development

# ----------------------------------------------------------------------------
# Stripe / Billing
# ----------------------------------------------------------------------------
STRIPE_ENABLED=false
BILLING_BACKGROUND_JOBS_ENABLED=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_METER_EVENT_NAME=moneat_overage_units

# ----------------------------------------------------------------------------
# Legal document versions
# ----------------------------------------------------------------------------
LEGAL_TERMS_VERSION=2026-02-08
LEGAL_PRIVACY_VERSION=2026-02-08

# ----------------------------------------------------------------------------
# Slack Integration
# ----------------------------------------------------------------------------
SLACK_ENABLED=false
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# Production default: https://api.moneat.io/v1/integrations/slack/oauth/callback
SLACK_REDIRECT_URI=http://localhost:8080/v1/integrations/slack/oauth/callback

# ----------------------------------------------------------------------------
# Discord Integration
# ----------------------------------------------------------------------------
DISCORD_ENABLED=false
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
# Production default: https://api.moneat.io/v1/integrations/discord/oauth/callback
DISCORD_REDIRECT_URI=http://localhost:8080/v1/integrations/discord/oauth/callback

# ----------------------------------------------------------------------------
# On-Call / Push Notifications
# CRITICAL: EXPO_TOKEN is required when ONCALL_ENABLED=true
# ----------------------------------------------------------------------------
ONCALL_ENABLED=false
EXPO_TOKEN=

# ----------------------------------------------------------------------------
# OAuth Providers (social login)
# ----------------------------------------------------------------------------
# GitHub
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Apple Sign In (APPLE_PRIVATE_KEY = base64-encoded .p8 file)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ----------------------------------------------------------------------------
# AI Chat Assistant (OpenAI)
# Automatically enabled for admin users when API key is set
# ----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2048

# ----------------------------------------------------------------------------
# Miscellaneous
# ----------------------------------------------------------------------------
# Cache TTL for SDK version lookups in setup docs (seconds)
GITHUB_VERSIONS_CACHE_TTL_SECONDS=21600

# Self-host telemetry (only active when SELF_HOST=true)
# Anonymous usage metrics help us improve Moneat for self-hosters.
# Set to false to opt out. See https://moneat.io/docs/self-hosting/telemetry
TELEMETRY_ENABLED=true
# TELEMETRY_ENDPOINT=https://telemetry.moneat.io/v1/pulse

# Demo Mode (for public demo deployments)
DEMO_ENABLED=false
# Timestamp (ms) anchoring demo data — defaults to current time if unset
DEMO_EPOCH_MS=

# Continuous profile storage
# Should point to a persistent mounted volume in production.
PROFILE_STORAGE_PATH=/var/lib/moneat/profiles
# Max accepted profile payload size in bytes (default: 10 MiB).
PROFILE_MAX_PAYLOAD_BYTES=10485760

# ----------------------------------------------------------------------------
# Datadog Agent Integration
# ----------------------------------------------------------------------------
# Enable with: docker compose --profile datadog up -d
# The entrypoint script attaches the DD Java agent when DD_AGENT_HOST is set.
# DD_AGENT_HOST=datadog-agent
# DD_SERVICE=moneat-backend
# DD_ENV=production
# DD_VERSION=
# DD_PROFILING_ENABLED=true
# DD_PROFILING_HEAP_ENABLED=true
# DD_TRACE_ENABLED=true
# DD_TRACE_SAMPLE_RATE=1.0
# DD_LOGS_INJECTION=true
# DD_DYNAMIC_INSTRUMENTATION_ENABLED=true
# DD_JMXFETCH_ENABLED=true
# DD_RUNTIME_METRICS_ENABLED=true
