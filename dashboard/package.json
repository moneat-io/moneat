{
  "name": "moneat-dashboard",
  "private": true,
  "version": "0.0.1",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/moneat-io/moneat.git",
    "directory": "dashboard"
  },
  "type": "module",
  "scripts": {
    "predev": "node ./scripts/sync-enterprise-if-present.mjs",
    "dev": "node ./scripts/dev.mjs",
    "sync-enterprise": "node ./scripts/sync-enterprise.mjs",
    "dev:enterprise": "node ./scripts/dev.mjs --enterprise",
    "prebuild": "node ./scripts/sync-enterprise-if-present.mjs",
    "build": "npm run lint && tsc && vite build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
