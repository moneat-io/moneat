    "jsdom": "^28.0.0",
    "msw": "^2.12.10",
    "postcss": "^8.4.33",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.3.3",
    "vite": "^7.0.0",
    "vitest": "^4.0.18"
  }
