# ============================================================================
# MONEAT DASHBOARD (FRONTEND) ENVIRONMENT CONFIGURATION
# ============================================================================
# This is an example configuration for LOCAL DEVELOPMENT.
# Production defaults are already set in the code.
# ============================================================================

# Backend API URL. Production default: https://api.moneat.io
VITE_BACKEND_URL=http://localhost:8080
# Some pages use VITE_API_URL as an alias — keep in sync with VITE_BACKEND_URL
VITE_API_URL=http://localhost:8080

# Legal document versions (must match backend LEGAL_*_VERSION values)
VITE_LEGAL_TERMS_VERSION=2026-02-08
VITE_LEGAL_PRIVACY_VERSION=2026-02-08

# Sentry (frontend self-monitoring — leave DSN empty to disable)
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# Moneat product analytics (leave key empty to disable)
VITE_ANALYTICS_KEY=

# Datadog RUM (Enterprise only — leave empty to disable)
# VITE_DD_APPLICATION_ID=
# VITE_DD_CLIENT_TOKEN=
# VITE_DD_SITE=datadoghq.com
# VITE_DD_SERVICE=moneat-dashboard
# VITE_DD_ENV=production

