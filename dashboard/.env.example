# ============================================================================
# MONEAT DASHBOARD (FRONTEND) ENVIRONMENT CONFIGURATION
# ============================================================================
# This is an example configuration for LOCAL DEVELOPMENT.
# Production defaults are already set in the code.
# ============================================================================

# Backend API URL
# Production default: https://api.moneat.io
# For local development, point to your local backend:
VITE_BACKEND_URL=http://localhost:8080

# Sentry Configuration (for frontend self-monitoring)
# Leave DSN empty to disable Sentry
VITE_SENTRY_DSN=
# Production default: production
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# AI Chat Assistant
# Set to "true" to enable the AI chat widget
VITE_AI_CHAT_ENABLED=false

