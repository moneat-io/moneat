# syntax=docker/dockerfile:1.22
FROM node:24-alpine AS dashboard-build
WORKDIR /app
COPY dashboard/package.json dashboard/package-lock.json dashboard/.npmrc ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci --prefer-offline --no-audit
COPY dashboard/ .
ARG VITE_BACKEND_URL="__MONEAT_BACKEND_URL__"
ARG VITE_SENTRY_DSN="__MONEAT_SENTRY_DSN__"
ARG VITE_SENTRY_ENVIRONMENT="__MONEAT_SENTRY_ENVIRONMENT__"
ARG VITE_SENTRY_TRACES_SAMPLE_RATE="__MONEAT_SENTRY_TRACES_SAMPLE_RATE__"
ARG VITE_ANALYTICS_KEY="__MONEAT_ANALYTICS_KEY__"
ARG VITE_DD_APPLICATION_ID="__MONEAT_DD_APPLICATION_ID__"
ARG VITE_DD_CLIENT_TOKEN="__MONEAT_DD_CLIENT_TOKEN__"
ARG VITE_DD_PROXY_URL="__MONEAT_DD_PROXY_URL__"
ARG VITE_DD_SERVICE="__MONEAT_DD_SERVICE__"
ARG VITE_DD_ENV="__MONEAT_DD_ENV__"
ENV VITE_BACKEND_URL=$VITE_BACKEND_URL
ENV VITE_SENTRY_DSN=$VITE_SENTRY_DSN
ENV VITE_SENTRY_ENVIRONMENT=$VITE_SENTRY_ENVIRONMENT
ENV VITE_SENTRY_TRACES_SAMPLE_RATE=$VITE_SENTRY_TRACES_SAMPLE_RATE
ENV VITE_ANALYTICS_KEY=$VITE_ANALYTICS_KEY
ENV VITE_DD_APPLICATION_ID=$VITE_DD_APPLICATION_ID
ENV VITE_DD_CLIENT_TOKEN=$VITE_DD_CLIENT_TOKEN
ENV VITE_DD_PROXY_URL=$VITE_DD_PROXY_URL
ENV VITE_DD_SERVICE=$VITE_DD_SERVICE
ENV VITE_DD_ENV=$VITE_DD_ENV
RUN npm run build

FROM nginx:alpine
COPY --from=dashboard-build /app/dist /usr/share/nginx/html
COPY dashboard/nginx.conf /etc/nginx/conf.d/default.conf
COPY dashboard/docker-entrypoint.sh /docker-entrypoint.d/40-substitute-env.sh
RUN chmod +x /docker-entrypoint.d/40-substitute-env.sh
EXPOSE 80
