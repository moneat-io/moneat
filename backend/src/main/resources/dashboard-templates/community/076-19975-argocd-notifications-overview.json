                "datasource": "__prometheus"
            },
            {
                "name": "job",
                "label": "Job",
                "type": "query",
                "query": "label_values(argocd_notifications_deliveries_total{cluster=\"$cluster\", namespace=~\"$namespace\"}, job)",
                "default_value": null,
                "current": null,
                "options": [],
                "datasource": "__prometheus"
            },
            {
                "name": "exported_service",
                "label": "Notifications Service",
                "type": "query",
                "query": "label_values(argocd_notifications_deliveries_total{cluster=\"$cluster\", namespace=~\"$namespace\", job=~\"$job\"}, exported_service)",
                "default_value": null,
                "current": null,
                "options": [],
                "datasource": "__prometheus"
            }
        ],
        "widgets": [
            {
                "title": "Summary",
                "widget_type": "section",
                "grid_x": 0,
                "grid_y": 0,
                "grid_w": 12,
                "grid_h": 1,
                "query_configs": [],
                "display_config": {
                    "collapsed": "false"
                },
                "sort_order": 0
            },
            {
                "title": "Notification Deliveries",
                "widget_type": "timeseries",
                "grid_x": 0,
                "grid_y": 1,
                "grid_w": 12,
                "grid_h": 8,
                "query_configs": [
                    {
                        "dataSource": "__prometheus",
                        "metrics": [
                            {
                                "function": "avg",
                                "field": null,
                                "alias": "{{ exported_service }} - Succeeded: {{ succeeded }}"
                            }
                        ],
                        "groupBy": [
                            {
                                "field": "timestamp",
                                "type": "time",
                                "interval": "auto"
                            }
                        ],
                        "filters": [],
                        "orderBy": null,
                        "limit": 5000,
                        "timeRange": {
                            "from": "now-24h",
                            "to": "now"
                        },
                        "rawQuery": "sum(\n  increase(\n    argocd_notifications_deliveries_total{\n      cluster=\"$cluster\",\nnamespace=~\"$namespace\",\njob=~\"$job\"\n\n,\nexported_service=~\"$exported_service\"\n\n    }[$__rate_interval]\n  )\n) by (exported_service, succeeded)\n",
                        "ref_id": "A"
                    }
                ],
                "display_config": {
                    "unit": "short",
                    "lineWidth": "1",
                    "fillOpacity": "1.0",
                    "stackMode": "normal",
                    "legendPlacement": "right",
                    "legendMode": "table"
                },
                "sort_order": 1
            },
            {
                "title": "Trigger Evaluations",
                "widget_type": "timeseries",
                "grid_x": 0,
                "grid_y": 9,
                "grid_w": 12,
                "grid_h": 8,
                "query_configs": [
                    {
                        "dataSource": "__prometheus",
                        "metrics": [
                            {
                                "function": "avg",
                                "field": null,
                                "alias": "{{ name }} - Triggered: {{ triggered }}"
                            }
                        ],
                        "groupBy": [
                            {
                                "field": "timestamp",
                                "type": "time",
                                "interval": "auto"
                            }
                        ],
                        "filters": [],
                        "orderBy": null,
                        "limit": 5000,
                        "timeRange": {
                            "from": "now-24h",
                            "to": "now"
                        },
                        "rawQuery": "sum(\n  increase(\n    argocd_notifications_trigger_eval_total{\n      cluster=\"$cluster\",\nnamespace=~\"$namespace\",\njob=~\"$job\"\n\n\n    }[$__rate_interval]\n  )\n) by (name, triggered)\n",
                        "ref_id": "A"
                    }
                ],
                "display_config": {
                    "unit": "short",
                    "lineWidth": "1",
                    "fillOpacity": "1.0",
                    "stackMode": "normal",
                    "legendPlacement": "right",
                    "legendMode": "table"
                },
                "sort_order": 2
            }
        ]
    }
