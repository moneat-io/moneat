        "widgets": [
            {
                "title": "Process CPU Usage",
                "widget_type": "timeseries",
                "grid_x": 0,
                "grid_y": 0,
                "grid_w": 5,
                "grid_h": 7,
                "query_configs": [
                    {
                        "dataSource": "__prometheus",
                        "metrics": [
                            {
                                "function": "avg",
                                "field": "cpu_percent",
                                "alias": "User CPU - {{instance}}"
                            }
                        ],
                        "groupBy": [
                            {
                                "field": "timestamp",
                                "type": "time",
                                "interval": "auto"
                            }
                        ],
                        "filters": [
                            {
                                "field": "instance",
                                "op": "like",
                                "value": "$instance",
                                "values": null
                            }
                        ],
                        "orderBy": null,
                        "limit": 5000,
                        "timeRange": {
                            "from": "now-24h",
                            "to": "now"
                        },
                        "rawQuery": "irate(process_cpu_user_seconds_total{instance=~\"$instance\"}[2m]) * 100",
                        "ref_id": "A"
                    },
                    {
                        "dataSource": "__prometheus",
                        "metrics": [
                            {
                                "function": "avg",
                                "field": "cpu_percent",
