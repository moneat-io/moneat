                "title": "apiserver request rate",
                "widget_type": "timeseries",
                "grid_x": 0,
                "grid_y": 0,
                "grid_w": 6,
                "grid_h": 8,
                "query_configs": [
                    {
                        "dataSource": "__prometheus",
                        "metrics": [
                            {
                                "function": "avg",
                                "field": null,
                                "alias": "{{verb}}"
                            }
                        ],
                        "groupBy": [
                            {
                                "field": "timestamp",
                                "type": "time",
                                "interval": "auto"
                            }
                        ],
                        "filters": [],
                        "orderBy": null,
                        "limit": 5000,
                        "timeRange": {
                            "from": "now-24h",
                            "to": "now"
                        },
                        "rawQuery": "sum(rate(apiserver_request_total[5m])) by (verb)",
                        "ref_id": "A"
                    }
                ],
                "display_config": {},
                "sort_order": 0
            },
