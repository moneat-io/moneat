                "query_configs": [
                    {
                        "dataSource": "__prometheus",
                        "metrics": [
                            {
                                "function": "avg",
                                "field": null,
                                "alias": "{{namespace}}"
                            }
                        ],
                        "groupBy": [
                            {
                                "field": "timestamp",
                                "type": "time",
                                "interval": "auto"
                            }
                        ],
                        "filters": [],
                        "orderBy": null,
                        "limit": 5000,
                        "timeRange": {
                            "from": "now-24h",
                            "to": "now"
                        },
                        "rawQuery": "sum(policy_report_result{policy=~\"$policy\", category=~\"$category\", severity=~\"$severity\", source=~\"$source\", kind=~\"$kind\", namespace=~\"$namespace\", status=\"pass\" } > 0) by (namespace)",
                        "ref_id": "A"
                    }
                ],
                "display_config": {
                    "decimals": "0",
