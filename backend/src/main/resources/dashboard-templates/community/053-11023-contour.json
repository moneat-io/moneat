                "query_configs": [
                    {
                        "dataSource": "__prometheus",
                        "metrics": [
                            {
                                "function": "avg",
                                "field": null,
                                "alias": "Namespace: {{ namespace }}"
                            }
                        ],
                        "groupBy": [
                            {
