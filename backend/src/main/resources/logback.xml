<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <appender name="STDOUT_PLAIN" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %highlight(%-5level) %cyan(%logger{36}) - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Structured JSON output for container/K8s environments (enable via LOG_FORMAT=json) -->
    <appender name="STDOUT_JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeMdcKeyName>traceId</includeMdcKeyName>
            <includeMdcKeyName>spanId</includeMdcKeyName>
        </encoder>
    </appender>
    
    <!-- Moneat Log Appender: Sends logs to the logs table via OTLP -->
    <!-- Override these via env vars in production: MONEAT_LOGS_ENDPOINT, MONEAT_LOGS_DSN, MONEAT_LOGS_SERVICE_NAME, MONEAT_LOGS_ENVIRONMENT -->
    <!-- Note: Uses system properties (-D) which are set by EnvConfig.initialize() from .env file -->
    <appender name="MONEAT" class="com.moneat.logging.MoneatLogAppender">
        <endpoint>${MONEAT_LOGS_ENDPOINT:-https://api.moneat.io/v1/logs/otlp}</endpoint>
        <dsn>${MONEAT_LOGS_DSN:-}</dsn>
        <serviceName>${MONEAT_LOGS_SERVICE_NAME:-moneat-backend}</serviceName>
        <environment>${MONEAT_LOGS_ENVIRONMENT:-development}</environment>
    </appender>

    <!-- Select console appender based on LOG_FORMAT env var (default: plain) -->
    <property name="LOG_FORMAT" value="${LOG_FORMAT:-plain}" />

    <!-- Default to INFO for all libraries to reduce noise -->
    <if condition='property("LOG_FORMAT").equals("json")'>
        <then>
            <root level="INFO">
                <appender-ref ref="STDOUT_JSON"/>
                <appender-ref ref="MONEAT"/>
            </root>
        </then>
        <else>
            <root level="INFO">
                <appender-ref ref="STDOUT_PLAIN"/>
                <appender-ref ref="MONEAT"/>
            </root>
        </else>
    </if>

    <!-- Enable DEBUG only for your application code -->
    <logger name="com.moneat" level="INFO"/>
    <logger name="com.moneat.moneat.routes.StripeWebhookRoutes" level="DEBUG"/>
    
    <!-- Keep common noisy libraries at WARN level -->
    <logger name="io.lettuce" level="WARN"/>
    <logger name="io.netty" level="WARN"/>
    <logger name="com.zaxxer.hikari" level="INFO"/>
    <logger name="io.ktor" level="INFO"/>
    <logger name="Exposed" level="INFO"/>
    <logger name="org.flywaydb" level="INFO"/>
    <logger name="io.opentelemetry" level="WARN"/>

    <!-- Prevent telemetry feedback loops: ingestion/telemetry loggers should not emit back to OTLP -->
    <!-- Use STDOUT_JSON or STDOUT_PLAIN based on LOG_FORMAT for consistent output -->
    <if condition='property("LOG_FORMAT").equals("json")'>
        <then>
            <logger name="com.moneat.routes.IngestRoutesKt" level="INFO" additivity="false">
                <appender-ref ref="STDOUT_JSON"/>
            </logger>
            <logger name="com.moneat.routes.LogRoutesKt" level="INFO" additivity="false">
                <appender-ref ref="STDOUT_JSON"/>
            </logger>
            <logger name="com.moneat.services.IngestionWorkerKt" level="INFO" additivity="false">
                <appender-ref ref="STDOUT_JSON"/>
            </logger>
            <logger name="com.moneat.services.LogIngestionWorkerKt" level="INFO" additivity="false">
                <appender-ref ref="STDOUT_JSON"/>
            </logger>
            <logger name="Application" level="INFO" additivity="false">
                <appender-ref ref="STDOUT_JSON"/>
            </logger>
        </then>
        <else>
            <logger name="com.moneat.routes.IngestRoutesKt" level="INFO" additivity="false">
                <appender-ref ref="STDOUT_PLAIN"/>
            </logger>
            <logger name="com.moneat.routes.LogRoutesKt" level="INFO" additivity="false">
                <appender-ref ref="STDOUT_PLAIN"/>
            </logger>
            <logger name="com.moneat.services.IngestionWorkerKt" level="INFO" additivity="false">
                <appender-ref ref="STDOUT_PLAIN"/>
            </logger>
            <logger name="com.moneat.services.LogIngestionWorkerKt" level="INFO" additivity="false">
                <appender-ref ref="STDOUT_PLAIN"/>
            </logger>
            <logger name="Application" level="INFO" additivity="false">
                <appender-ref ref="STDOUT_PLAIN"/>
            </logger>
        </else>
    </if>
</configuration>
